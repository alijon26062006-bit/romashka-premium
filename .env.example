# ============================================================
# Ромашка Premium — настройки окружения
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env НИКОГДА не попадает в git.
# ============================================================

# Порт, на котором работает сервер
PORT=3000

# Локальный порт при установке рядом с существующим nginx
# (заполняется автоматически скриптом deploy-nginx.sh)
APP_PORT=3000

# Логин и пароль администратора.
# ОБЯЗАТЕЛЬНО поменяйте пароль перед публикацией в интернете!
ADMIN_USER=admin
ADMIN_PASSWORD=

# Ваш домен вместе с https:// (без слэша в конце).
# Нужен для корректных ссылок в Google и превью в WhatsApp.
# Пример: SITE_URL=https://romashka.tj
SITE_URL=

# Домен для автоматического получения SSL-сертификата (используется в Docker).
# Пример: DOMAIN=romashka.tj
DOMAIN=

# Почта для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=

# ---------- Бесплатный домен DuckDNS (не обязательно) ----------
# Заполняйте, только если пользуетесь duckdns.org И у сервера меняется IP.
# DUCKDNS_SUBDOMAIN — имя без .duckdns.org. Для romashka.duckdns.org пишите: romashka
# DUCKDNS_TOKEN     — токен со страницы duckdns.org после входа
# Если заполнены оба, deploy.sh сам запустит обновление IP каждые 5 минут.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# ---------- Панель управления в Telegram (не обязательно) ----------
# Позволяет добавлять и удалять товары прямо из телефона и смотреть,
# сколько людей заходило на сайт. Если оставить пусто — бот не запустится,
# магазин будет работать как раньше.
#
# TELEGRAM_BOT_TOKEN — выдаёт @BotFather в Telegram: /newbot и следуйте шагам.
# TELEGRAM_ADMIN_IDS — числовые id тех, кому можно управлять магазином,
#                      через запятую. Свой id скажет @userinfobot.
#                      Пока список пуст, бот в ответ на любое сообщение
#                      подскажет id написавшего — его и впишите.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Часовой пояс магазина: по нему считается «сегодня» в статистике
# и показывается время заявок. По умолчанию Asia/Dushanbe.
SHOP_TZ=Asia/Dushanbe
